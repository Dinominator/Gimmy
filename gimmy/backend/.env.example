# Backend Port
PORT=5001

# Firebase Project ID (Optional - for reference)
# FIREBASE_PROJECT_ID=your-firebase-project-id

# JWT Secret Key
JWT_SECRET=yourSuperSecretJWTKeyForGimmyApp

# Email Configuration (for Nodemailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587 # or 465 for SSL
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_FROM='"Gimmy Fitness App" <no-reply@example.com>' # Sender name and address

# Add any other environment variables you might need
